# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (global recursive)
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions

# mobile & build artifacts (global recursive)
**/.expo/
**/android/
**/ios/
**/dist/
**/web-build/
**/build/

# functions
functions/lib/
functions/livekit-agent/venv/
functions/livekit-agent/__pycache__/

# testing
/coverage

# next.js
.next/
/out/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase functions
/functions/node_modules
/functions/lib
/functions/.firebase
/functions/*.log
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# IDE
.idea/
.vscode/

# playwright
/test-results/
/playwright-report/
/blob-report/

# logs
*.log

# gemini
.gemini/
conductor/
