{
  "expo": {
    "name": "lemonade-mvp",
    "slug": "lemonade-mvp",
    "version": "1.0.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "scheme": "lemonademvp",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dawan.lemonademvp",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera for video diagnostics.",
        "NSMicrophoneUsageDescription": "This app uses the microphone for voice commands and diagnostics."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.dawan.lemonademvp",
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app",
          "asyncRoutes": {
            "android": true,
            "ios": true,
            "web": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1a1a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "react-native-vision-camera",
      [
        "llama.rn",
        {
          "n_gpu_layers": "auto",
          "use_metal": true
        }
      ],
      "./plugins/withIosModularHeaders",
      "./plugins/withMetaWearables"
    ],
    "metro": {
      "configFile": "./metro.config.cjs"
    }
  }
}
