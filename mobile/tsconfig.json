{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@mobile/*": [
        "./*"
      ],
      "@core/*": [
        "../src/core/*"
      ],
      "@infrastructure/*": [
        "../src/infrastructure/*"
      ],
      "@web-shared-hooks/*": [
        "../src/presentation/hooks/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}