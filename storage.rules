rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Sessions folder: 
    // Secure approach: Check if the user owns the corresponding Firestore session document.
    // This requires a Firestore read (costly but secure).
    match /sessions/{sessionId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && 
        firestore.get(/databases/(default)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
    }
    
    // Default: Deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
