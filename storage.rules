rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Sessions folder: Authenticated users can upload
    match /sessions/{sessionId}/{allPaths=**} {
      // Anyone authenticated can upload (signed URLs handle this server-side)
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Default: Deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
