{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2020",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@lemonade/core": ["../packages/core/src/index.ts"],
      "@lemonade/infrastructure": ["../packages/infrastructure/src/index.ts"]
    },
    "types": ["node"]
  },
  "compileOnSave": true,
  "include": ["src"],
  "exclude": ["src/**/__tests__/**"]
}
