rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Vehicles: Users can only CRUD their own vehicles
    match /vehicles/{vehicleId} {
      allow read, write: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    
    // Sessions: Users can only access sessions for their vehicles
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      // Note: In production, validate that the session's vehicle belongs to the user
    }
    
    // Users: Users can only access their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
