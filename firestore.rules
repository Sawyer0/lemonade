rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection: Users can only access their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Vehicles Collection: Users can only access vehicles they own
    match /vehicles/{vehicleId} {
      // Allow create if the new document's userId matches the authenticated user
      allow create: if isOwner(request.resource.data.userId);
      
      // Allow read/update/delete if the existing document's userId matches the authenticated user
      allow read, update, delete: if isOwner(resource.data.userId);
    }

    // Sessions Collection: Users can only access sessions they own
    // (We denormalized userId to the session document for this purpose)
    match /sessions/{sessionId} {
      // Allow create if the new document's userId matches the authenticated user
      allow create: if isOwner(request.resource.data.userId);
      
      // Allow read/update/delete if the existing document's userId matches the authenticated user
      allow read, update, delete: if isOwner(resource.data.userId);
    }
  }
}
