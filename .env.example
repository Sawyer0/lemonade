# Copy to .env.local (gitignored) and fill in what you need.
# Never commit real keys.

# --- LLM provider -----------------------------------------------------------
# "vertex" (default) uses Gemini on Google Vertex AI with the GCP settings below.
# "groq" uses Groq's free OpenAI-compatible API for chat, safety checks and photo analysis.
LLM_PROVIDER=groq
GROQ_API_KEY=            # https://console.groq.com/keys
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b   # photo and live-frame analysis; video and audio need Vertex

# --- Firebase (web client) --------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Local only: point the web SDK at the Firebase emulators (inlined at build time; never set in production)
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# --- Firebase Admin / Google Cloud (server) ---------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=   # service account JSON on one line
GCLOUD_PROJECT=
GCLOUD_LOCATION=us-central1
GCLOUD_MEDIA_BUCKET=

# --- Optional services --------------------------------------------------------
TAVILY_API_KEY=              # https://app.tavily.com — 1,000 free searches/month, basic = 1 credit
SUPERMEMORY_API_KEY=
SUPERMEMORY_SPACE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=

# --- Live voice agent (agent/) ---------------------------------------------
# Outside production these default to `livekit-server --dev` (ws://localhost:7880, devkey/secret).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GOOGLE_API_KEY=                 # Gemini Live: the agent's ears, reasoning and default native-audio voice
RESEMBLE_API_KEY=               # optional: speak replies with Resemble instead of Gemini's voice
RESEMBLE_VOICE_UUID=            # optional: Resemble voice to use
# RUN_LIVE_AGENT_TESTS=true     # opt in to agent/test/live (needs the four keys above)

# --- Security ---------------------------------------------------------------
# HMAC key for the identity headers the middleware seals. Required in production
# (32+ chars, e.g. `openssl rand -hex 32`); the server refuses to start without it.
# Left empty in development, a fixed dev-only key is used.
SECURITY_INTERNAL_SECRET=
DEV_BYPASS_SECRET=              # local only: lets requests skip Firebase auth; ignored in production
