# Copy to .env.local (gitignored) and fill in what you need.
# Never commit real keys.

# --- LLM provider -----------------------------------------------------------
# "vertex" (default) uses Gemini on Google Vertex AI with the GCP settings below.
# "groq" uses Groq's free OpenAI-compatible API for chat and safety checks.
LLM_PROVIDER=groq
GROQ_API_KEY=            # https://console.groq.com/keys
# GROQ_MODEL=openai/gpt-oss-20b

# --- Firebase (web client) --------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin / Google Cloud (server) ---------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=   # service account JSON on one line
GCLOUD_PROJECT=
GCLOUD_LOCATION=us-central1
GCLOUD_MEDIA_BUCKET=

# --- Optional services --------------------------------------------------------
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
SUPERMEMORY_API_KEY=
SUPERMEMORY_SPACE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=

# --- Live voice agent (agent/) ---------------------------------------------
# Outside production these default to `livekit-server --dev` (ws://localhost:7880, devkey/secret).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GOOGLE_API_KEY=                 # Gemini Live: the agent's ears, reasoning and default native-audio voice
RESEMBLE_API_KEY=               # optional: speak replies with Resemble instead of Gemini's voice
RESEMBLE_VOICE_UUID=            # optional: Resemble voice to use
# RUN_LIVE_AGENT_TESTS=true     # opt in to agent/test/live (needs the four keys above)

# --- Security ---------------------------------------------------------------
SECURITY_INTERNAL_SECRET=       # HMAC key for headers sealed by the middleware
DEV_BYPASS_SECRET=              # local only: lets requests skip Firebase auth
