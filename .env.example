# Copy to .env.local (gitignored) and fill in what you need.
# Never commit real keys.

# --- LLM provider -----------------------------------------------------------
# "vertex" (default) uses Gemini on Google Vertex AI with the GCP settings below.
# "groq" uses Groq's free OpenAI-compatible API for chat and safety checks.
LLM_PROVIDER=groq
GROQ_API_KEY=            # https://console.groq.com/keys
# GROQ_MODEL=openai/gpt-oss-20b

# --- Firebase (web client) --------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin / Google Cloud (server) ---------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=   # service account JSON on one line
GCLOUD_PROJECT=
GCLOUD_LOCATION=us-central1
GCLOUD_MEDIA_BUCKET=

# --- Optional services --------------------------------------------------------
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
SUPERMEMORY_API_KEY=
SUPERMEMORY_SPACE_ID=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=

# --- Security ---------------------------------------------------------------
SECURITY_INTERNAL_SECRET=       # HMAC key for headers sealed by the middleware
DEV_BYPASS_SECRET=              # local only: lets requests skip Firebase auth
