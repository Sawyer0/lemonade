  "license": "Apache-2.0",
  "description": "LiveKit voice agent (the live Master Tech) and its room token server",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "(cd .. && patch-package) && vitest run --root .. agent",
    "test:live": "RUN_LIVE_AGENT_TESTS=true vitest run --root .. agent/test/live",
    "bakeoff": "tsx test/bakeoff/runner.ts",
    "dev": "tsx src/index.ts dev",
    "start": "tsx src/index.ts start",
    "worker": "tsx src/worker.ts dev"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "@google/genai": "^2.29.1",
    "@lemonade/core": "file:../packages/core",
    "@lemonade/infrastructure": "file:../packages/infrastructure",
    "@livekit/agents": "1.9.5",
    "@livekit/agents-plugin-cartesia": "1.9.5",
    "@livekit/agents-plugin-deepgram": "1.9.5",
    "@livekit/agents-plugin-google": "1.9.5",
    "@livekit/agents-plugin-openai": "1.9.5",
    "@livekit/agents-plugin-silero": "1.9.5",
    "@livekit/agents-plugin-xai": "1.9.5",
    "@livekit/rtc-node": "^1.2.2",
    "elysia": "^1.4.19",
    "firebase-admin": "^13.6.0",
    "livekit-server-sdk": "^2.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.3"
